rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Incidents collection
    match /incidents/{incidentId} {
      // Allow read access to all authenticated users
      allow read: if request.auth != null;

      // Allow create if user is authenticated and createdBy matches their UID
      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.description is string
        && request.resource.data.category in ['flood', 'fire', 'medical', 'accident', 'cyber_scam', 'crime', 'infrastructure']
        && request.resource.data.severity in ['low', 'medium', 'high']
        && request.resource.data.status in ['open', 'investigating', 'resolved', 'closed'];

      // Allow update if user is the creator
      allow update: if request.auth != null
        && resource.data.createdBy == request.auth.uid;

      // Allow delete if user is the creator
      allow delete: if request.auth != null
        && resource.data.createdBy == request.auth.uid;
    }

    // AI Reports collection
    match /ai_reports/{reportId} {
      // Allow read access to all authenticated users
      allow read: if request.auth != null;

      // Allow create for authenticated users (created by system after incident analysis)
      allow create: if request.auth != null
        && request.resource.data.incidentId is string
        && request.resource.data.category in ['flood', 'fire', 'medical', 'accident', 'cyber_scam', 'crime', 'infrastructure']
        && request.resource.data.severity in ['low', 'medium', 'high']
        && request.resource.data.threatScore is number
        && request.resource.data.threatScore >= 1
        && request.resource.data.threatScore <= 100
        && request.resource.data.emergencyLevel in ['Low', 'Moderate', 'High', 'Critical']
        && request.resource.data.summary is string
        && request.resource.data.safetyAdvice is string
        && request.resource.data.fakeReportProbability in ['Low', 'Medium', 'High']
        && request.resource.data.recommendedAction is string;

      // No updates or deletes allowed for AI reports (immutable)
      allow update, delete: if false;
    }

    // Notifications collection
    match /notifications/{notificationId} {
      // Allow read access only to the notification owner
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;

      // Allow create for authenticated users (userId must match auth.uid)
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.type in ['nearby_incident', 'high_risk_alert', 'scam_detected', 'emergency_broadcast', 'sos_request', 'ai_analysis_complete', 'system_alert']
        && request.resource.data.severity in ['info', 'warning', 'critical', 'emergency']
        && request.resource.data.title is string
        && request.resource.data.message is string;

      // Allow update only to mark as read (userId must match)
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);

      // Allow delete only by the owner
      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // SOS Alerts collection
    match /sos_alerts/{sosId} {
      // Allow read access to all authenticated users (for emergency response)
      allow read: if request.auth != null;

      // Allow create for authenticated users
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.emergencyType in ['medical', 'accident', 'fire', 'crime', 'natural_disaster', 'cyber_emergency']
        && request.resource.data.latitude is number
        && request.resource.data.longitude is number
        && request.resource.data.status in ['active', 'responding', 'resolved', 'cancelled'];

      // Allow update for status changes (by owner or responders)
      allow update: if request.auth != null
        && (resource.data.userId == request.auth.uid || request.resource.data.responders.hasAny([request.auth.uid]))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'responders']);

      // Allow delete only by the owner
      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // Emergency Broadcasts collection
    match /emergency_broadcasts/{broadcastId} {
      // Allow read access to all authenticated users
      allow read: if request.auth != null;

      // Allow create for authenticated users (typically admin/system)
      allow create: if request.auth != null
        && request.resource.data.type in ['flood_warning', 'cyber_attack_warning', 'severe_weather', 'city_emergency', 'terror_threat', 'public_safety']
        && request.resource.data.severity in ['info', 'warning', 'critical', 'emergency']
        && request.resource.data.title is string
        && request.resource.data.message is string
        && request.resource.data.active is bool;

      // Allow update for deactivation (by creator)
      allow update: if request.auth != null
        && resource.data.createdBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active']);

      // Allow delete only by the creator
      allow delete: if request.auth != null
        && resource.data.createdBy == request.auth.uid;
    }

    // Activities collection
    match /activities/{activityId} {
      // Allow read access to all authenticated users
      allow read: if request.auth != null;

      // Allow create for authenticated users (system-generated)
      allow create: if request.auth != null
        && request.resource.data.type in ['incident_reported', 'ai_analysis', 'sos_triggered', 'broadcast_sent', 'incident_resolved', 'scam_detected', 'user_joined']
        && request.resource.data.title is string
        && request.resource.data.description is string;

      // No updates or deletes allowed for activities (immutable log)
      allow update, delete: if false;
    }

    // Users collection (for future use)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
